---
import type { Game } from '../types/game';
import Tag from './Tag.astro';
import ArrowRight from '../assets/icons/arrow-right.svg';

interface Props {
    game: Game;
}

const { game } = Astro.props;
---

<a
    href={`/game/${game.id}`}
    class="group relative block overflow-hidden rounded-2xl border border-white/10 bg-slate-900/80 shadow-xl shadow-black/20 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-400/40 hover:shadow-blue-950/40 focus:outline-none focus:ring-2 focus:ring-blue-400"
    data-testid="game-card"
    data-game-id={game.id}
    data-game-title={game.title}
    data-category-id={game.category?.id ?? ''}
    data-publisher-id={game.publisher?.id ?? ''}
>
    <div class="relative p-6">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-blue-400 via-purple-400 to-transparent opacity-70"></div>
        <div class="absolute -right-16 -top-16 h-36 w-36 rounded-full bg-blue-500/10 blur-3xl transition-opacity duration-300 group-hover:opacity-100"></div>
        <div class="relative z-10">
            <div class="mb-6 flex items-start justify-between gap-4">
                <span class="text-[10px] font-medium uppercase tracking-[0.22em] text-slate-500">Featured title</span>
                <ArrowRight class="h-5 w-5 text-slate-500 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-blue-300" aria-hidden="true" />
            </div>
            <h3 class="mb-3 text-xl font-semibold tracking-tight text-slate-100 transition-colors duration-300 group-hover:text-blue-300" data-testid="game-title">{game.title}</h3>

            {(game.category?.name || game.publisher?.name) && (
                <div class="mb-4 flex flex-wrap gap-2">
                    {game.category?.name && (
                        <Tag color="blue" data-testid="game-category">
                            {game.category.name}
                        </Tag>
                    )}
                    {game.publisher?.name && (
                        <Tag color="purple" data-testid="game-publisher">
                            {game.publisher.name}
                        </Tag>
                    )}
                </div>
            )}

            <p class="mb-6 line-clamp-2 text-sm leading-6 text-slate-400" data-testid="game-description">{game.description}</p>

            <div class="flex items-center justify-between border-t border-white/10 pt-4 text-sm">
                <span class="font-medium text-blue-300">View details</span>
                <span class="text-slate-500">Explore →</span>
            </div>
        </div>
    </div>
</a>
