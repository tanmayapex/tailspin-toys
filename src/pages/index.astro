---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8 sm:py-12">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="mt-2 text-sm text-slate-400" data-testid="results-summary" aria-live="polite">
          Curated collection · <span data-testid="results-count">{games.length}</span> of {games.length} games
        </p>
      </div>

      <form
        class="mb-10 grid gap-7 rounded-2xl border border-white/10 bg-slate-900/80 p-5 shadow-xl shadow-black/20 sm:p-7 md:grid-cols-[1fr_16rem_auto] md:items-end"
        data-testid="game-filters"
        aria-label="Filter games"
      >
        <details class="group relative z-20" data-testid="category-filter-menu">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-lg border border-white/10 bg-slate-800 px-4 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-blue-400/50 focus:outline-none focus:ring-2 focus:ring-blue-400 [&::-webkit-details-marker]:hidden">
            <span>
              <span class="mb-1 block text-[10px] uppercase tracking-[0.18em] text-slate-300">Browse by category</span>
              <span data-testid="category-filter-summary">All categories</span>
            </span>
            <span aria-hidden="true" class="text-slate-500 transition-transform duration-200 group-open:rotate-180">⌄</span>
          </summary>
          <fieldset class="absolute left-0 z-30 mt-2 grid w-full min-w-64 grid-cols-2 gap-1 rounded-xl border border-slate-700 bg-[#0b1220] p-2 shadow-2xl shadow-black/60 sm:grid-cols-3">
            <legend class="sr-only">Filter by category</legend>
            {categories.map((category) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-lg px-3 text-sm text-slate-300 transition-colors duration-200 hover:bg-white/10 hover:text-white">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="h-4 w-4 shrink-0 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-400"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </fieldset>
        </details>

        <label class="block text-sm font-medium text-slate-200">
          <span class="mb-3 block text-xs uppercase tracking-[0.18em] text-slate-400">Publisher</span>
          <select
            name="publisher"
            class="min-h-11 w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </label>

        <button
          type="button"
          class="min-h-11 rounded-lg bg-blue-500/10 px-4 py-2 text-sm font-medium text-blue-200 transition-colors duration-200 hover:bg-blue-500/20 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state" aria-live="polite">
        <EmptyState text="No games match your selected filters.">
          <button type="button" data-testid="empty-clear-filters" class="mt-4 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white focus:outline-none focus:ring-2 focus:ring-blue-400">
            Clear filters
          </button>
        </EmptyState>
      </div>
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const count = document.querySelector('[data-testid="results-count"]');
  const total = cards.length;
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const categoryMenu = document.querySelector<HTMLDetailsElement>('[data-testid="category-filter-menu"]');
  const categorySummary = document.querySelector('[data-testid="category-filter-summary"]');
  const clearButtons = document.querySelectorAll<HTMLButtonElement>(
    '[data-testid="clear-filters"], [data-testid="empty-clear-filters"]',
  );

  function readState() {
    const params = new URLSearchParams(window.location.search);
    return {
      categories: params.getAll('category'),
      publisher: params.get('publisher') ?? '',
    };
  }

  function writeState() {
    if (!filters) return;
    const params = new URLSearchParams();
    filters.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')
      .forEach((input) => params.append('category', input.value));
    const publisher = filters.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value;
    if (publisher) params.set('publisher', publisher);
    const query = params.toString();
    window.history.replaceState(null, '', query ? `/?${query}` : '/');
  }

  function applyState(state: { categories: string[]; publisher: string }) {
    if (!filters || !count || !grid || !emptyState) return;
    filters.querySelectorAll<HTMLInputElement>('input[name="category"]')
      .forEach((input) => { input.checked = state.categories.includes(input.value); });
    const publisher = filters.querySelector<HTMLSelectElement>('select[name="publisher"]');
    if (publisher) publisher.value = state.publisher;
    if (categorySummary) {
      const selectedNames = Array.from(
        filters.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'),
      ).map((input) => input.nextElementSibling?.textContent?.trim()).filter(Boolean);
      categorySummary.textContent =
        selectedNames.length === 0 ? 'All categories' :
        selectedNames.length === 1 ? selectedNames[0] ?? 'All categories' :
        `${selectedNames.length} categories selected`;
    }

    let visibleCount = 0;
    cards.forEach((card) => {
      const categoryMatch =
        state.categories.length === 0 ||
        state.categories.includes(card.dataset.categoryId ?? '');
      const publisherMatch =
        !state.publisher || state.publisher === card.dataset.publisherId;
      const visible = categoryMatch && publisherMatch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });
    count.textContent = String(visibleCount);
    const hasFilters = state.categories.length > 0 || state.publisher !== '';
    grid.classList.toggle('hidden', visibleCount === 0);
    emptyState.classList.toggle('hidden', !hasFilters || visibleCount > 0);
    count.parentElement?.setAttribute('aria-label', `Showing ${visibleCount} of ${total} games`);
  }

  filters?.addEventListener('change', () => {
    writeState();
    applyState(readState());
  });
  document.addEventListener('pointerdown', (event) => {
    if (categoryMenu?.open && !categoryMenu.contains(event.target as Node)) {
      categoryMenu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && categoryMenu?.open) {
      categoryMenu.open = false;
    }
  });
  clearButtons.forEach((button) => button.addEventListener('click', () => {
    window.history.replaceState(null, '', '/');
    applyState({ categories: [], publisher: '' });
  }));
  window.addEventListener('popstate', () => applyState(readState()));
  applyState(readState());
</script>
